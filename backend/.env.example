# Copy to backend/.env. SQLite is the default so the demo needs no extra services.
DATABASE_URL=sqlite:///./data/hybrid.db

# Use a long random string outside local development.
# Set ENVIRONMENT=production on a public deploy to hide /docs. API routes stay the same.
JWT_SECRET=development-only-please-change-me!!
ENVIRONMENT=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seeded duty-analyst account. Quote the password so '#' is not treated as a comment.
DEMO_EMAIL=analyst@example.com
DEMO_PASSWORD="Forecast#2026"
DEMO_NAME=Duty Analyst

# synthetic | directory
# directory reads FORECAST_DIR/cube.npz (see blender/data_loader.py)
DATA_SOURCE=synthetic
FORECAST_DIR=./data/forecasts

# APScheduler interval for the operational blend. Set true to disable.
DISABLE_SCHEDULER=false
SCHEDULE_HOURS=6

# Production example (Postgres). Create the database first, then point here:
# DATABASE_URL=postgresql+psycopg://blend:blend@localhost:5432/hybrid
